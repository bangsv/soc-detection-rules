[
  { "viewport": [390, 844], "mobile": true },
  { "wait": 1500 },
  { "check": ["scenario cards on mobile", "document.querySelectorAll('[data-scenario]').length"] },
  { "check": ["no horizontal overflow (mobile)", "document.documentElement.scrollWidth <= 392"] },
  { "shot": "ui-mobile-hero.png" },
  { "eval": "document.querySelector('#nav-toggle').click()" },
  { "wait": 400 },
  { "check": ["mobile menu opened", "document.querySelector('#nav').dataset.open === 'true'"] },
  { "shot": "ui-mobile-menu.png" },
  { "eval": "document.querySelector('#nav a').click()" },
  { "wait": 500 },
  { "check": ["mobile menu closed after nav", "document.querySelector('#nav').dataset.open === 'false'"] },
  { "eval": "document.querySelector('#attacks-map').scrollIntoView()" },
  { "wait": 600 },
  { "shot": "ui-mobile-catalog.png" },
  { "click": "[data-scenario]" },
  { "wait": 1200 },
  { "check": ["detail on mobile", "document.querySelectorAll('#attack-detail .ioc-row').length"] },
  { "check": ["still no overflow", "document.documentElement.scrollWidth <= 392"] },
  { "eval": "document.querySelector('#attack-detail').scrollIntoView()" },
  { "wait": 500 },
  { "shot": "ui-mobile-detail.png" },
  { "eval": "document.querySelector('[data-ioc-tab=\"host\"]').click()" },
  { "wait": 300 },
  { "check": ["host tab filters panels", "document.querySelectorAll('#attack-detail .ioc__panel:not([hidden])').length === 1"] },
  { "eval": "document.querySelector('.ioc-trigger') || document.querySelector('#attack-detail [data-collect]').click()" },
  { "wait": 400 },
  { "check": ["tray works on mobile", "!document.querySelector('#tray').hidden"] },
  { "eval": "document.querySelector('#theme-toggle').click()" },
  { "wait": 400 },
  { "shot": "ui-mobile-light.png" },
  { "eval": "document.querySelector('#knowledge').scrollIntoView()" },
  { "wait": 700 },
  { "shot": "ui-mobile-doc.png" },
  { "check": ["doc readable on mobile", "document.querySelectorAll('#document h1, #document h2').length > 0"] }
]
