[
  { "wait": 3500 },
  { "check": ["панель правил есть на странице", "!!document.querySelector('#attack-rules') || !document.querySelector('#attack-detail:not([hidden])')"] },
  { "click": "[data-scenario]" },
  { "wait": 1600 },
  { "check": ["панель правил появилась", "!!document.querySelector('#attack-rules .rules')"] },
  { "check": ["вкладки типов правил", "document.querySelectorAll('#attack-rules .rule-tab').length"] },
  { "check": ["список файлов правил", "document.querySelectorAll('#attack-rules .rule-file').length"] },
  { "check": ["normalization_event.txt скрыт", "![...document.querySelectorAll('#attack-rules .rule-file')].some(el => el.textContent.includes('normalization_event'))"] },
  { "check": ["блок «Технические фрагменты» убран", "!document.querySelector('#attack-detail').textContent.includes('Технические фрагменты')"] },
  { "check": ["блок «Значения для поиска» убран", "!document.querySelector('#attack-detail').textContent.includes('Значения для поиска')"] },
  { "check": ["группы значений убраны", "document.querySelectorAll('#attack-detail .terms__group').length === 0"] },
  { "check": ["чипы значений убраны", "document.querySelectorAll('#attack-detail .term').length === 0"] },
  { "eval": "document.querySelector('#attack-rules').scrollIntoView({block:'start'})" },
  { "wait": 700 },
  { "shot": "detail-after-terms.png" },
  { "click": "#attack-rules .rule-file" },
  { "wait": 1200 },
  { "check": ["содержимое правила загрузилось", "!!document.querySelector('#attack-rules .rule-code')"] },
  { "check": ["показан путь правила", "document.querySelector('#attack-rules .rule-viewer__path').textContent.includes('/')"] },
  { "check": ["код без служебных строк #", "!document.querySelector('#attack-rules .rule-code').textContent.includes('# ═')"] },
