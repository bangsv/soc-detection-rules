  { "check": ["фильтр по типу сужает список", "document.querySelectorAll('#attack-rules .rule-file').length"] },
  { "check": ["содержимое сброшено при смене типа", "!document.querySelector('#attack-rules .rule-code')"] },
  { "eval": "document.querySelector('#attack-rules .rule-file').click()" },
  { "wait": 1100 },
  { "check": ["второе правило открывается", "!!document.querySelector('#attack-rules .rule-code')"] },
  { "check": ["нет горизонтального переполнения", "document.documentElement.scrollWidth <= window.innerWidth + 2"] },
  { "check": ["в DOM только одно правило", "document.querySelectorAll('#attack-rules .rule-code').length === 1"] }
