[
  { "wait": 3500 },
  { "click": "[data-scenario]" },
  { "wait": 1800 },
  { "check": ["панель triage есть", "!!document.querySelector('#attack-triage .triage')"] },
  { "check": ["вкладки по типам", "document.querySelectorAll('#attack-triage .rule-tab').length"] },
  { "check": ["карточки файлов", "document.querySelectorAll('#attack-triage .triage-card').length"] },
  { "check": ["нет фильтра по результату", "document.querySelectorAll('#attack-triage [data-triage-result]').length === 0"] },
  { "check": ["нет просмотрщика содержимого", "!document.querySelector('#attack-triage .rule-code')"] },
  { "check": ["карточка — ссылка на скачивание", "[...document.querySelectorAll('#attack-triage .triage-card')].every(a => a.tagName === 'A' && a.getAttribute('download'))"] },
  { "check": ["показано, чем открыть файл", "[...document.querySelectorAll('#attack-triage .triage-card__tool')].every(el => el.textContent.includes('Открыть в:'))"] },
  { "check": ["видна кнопка скачивания", "[...document.querySelectorAll('#attack-triage .triage-card__download')].every(el => el.textContent.includes('Скачать'))"] },
  { "check": ["not_success помечен как провал", "(() => { const c = [...document.querySelectorAll('#attack-triage .triage-card')].find(a => a.textContent.includes('not_success')); return c && c.dataset.result === 'fail'; })()"] },
  { "check": ["нет блока «Все файлы сценария»", "!document.querySelector('#attack-detail').textContent.includes('Все файлы сценария')"] },
  { "eval": "document.querySelector('#attack-triage').scrollIntoView({block:'start'})" },
  { "wait": 700 },
  { "shot": "triage-cards.png" },
  { "eval": "(() => { const i = document.querySelector('[data-triage-search]'); i.value = 'scanner'; i.dispatchEvent(new Event('input', {bubbles:true})); return 'ok'; })()" },
  { "wait": 700 },
  { "check": ["поиск по имени фильтрует", "document.querySelectorAll('#attack-triage .triage-card').length === 1"] },
  { "eval": "document.querySelector('#attack-triage').scrollIntoView({block:'start'})" },
  { "wait": 600 },
  { "shot": "triage-filtered.png" },
  { "eval": "(() => { const b = document.querySelector('[data-triage-reset]'); if (b) b.click(); else { const i = document.querySelector('[data-triage-search]'); i.value=''; i.dispatchEvent(new Event('input',{bubbles:true})); } return 'ok'; })()" },
  { "wait": 700 },
  { "check": ["сброс возвращает все файлы", "document.querySelectorAll('#attack-triage .triage-card').length > 1"] },
  { "eval": "(() => { const t = [...document.querySelectorAll('#attack-triage .rule-tab')].find(x => x.dataset.triageKind === 'suricata_logs'); t.click(); return 'ok'; })()" },
  { "wait": 600 },
  { "check": ["логи Suricata доступны к скачиванию", "document.querySelectorAll('#attack-triage .triage-card').length === 4"] },
  { "check": ["нет горизонтального переполнения", "document.documentElement.scrollWidth <= window.innerWidth + 2"] }
]
